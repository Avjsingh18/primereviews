# Supabase auth and existing ReviewFlow database
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SITE_URL=
# Server-only: generate independently with openssl rand -hex 32. Do not reuse keys.
SESSION_ENCRYPTION_KEY=
RATE_LIMIT_SECRET=
DATABASE_API_SECRET=
CRON_SECRET=
# Prisma uses the Supabase PostgreSQL connection string. Never expose this value to the browser.
DATABASE_URL=

# Optional production integrations.
OPENAI_API_KEY=
GOOGLE_MAPS_API_KEY=
# Fail closed. Enabling AI requires a reviewed conservative per-call maximum for
# the fixed model/token/tool/image limits. Provider budgets/alerts are not a
# substitute for these reservations; review billing safeguards separately.
AI_ENABLED=false
AI_PRICING_VERIFIED=false
AI_QR_MAX_CALL_CENTS=
AI_GLOBAL_DAILY_CENTS=
AI_GLOBAL_MONTHLY_CENTS=
AI_USER_DAILY_CENTS=
AI_USER_MONTHLY_CENTS=
# Google Places (New) powers the live current rating/review count and nearby ranking.
# Results are kept in the server-side cache for a fixed 24 hours.
# Optional AI-designed QR backgrounds. Uses the same server-only OPENAI_API_KEY.
QR_DESIGN_IMAGE_MODEL=gpt-image-2
QR_DESIGN_TIMEOUT_MS=120000
QR_DESIGN_CACHE_TTL_SECONDS=86400
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=
TOKEN_ENCRYPTION_KEY=

# Explicit demo defaults (not a real Google/AI connection).
USE_MOCK_GOOGLE=true
USE_MOCK_AI=true
