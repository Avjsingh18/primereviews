# Supabase auth and existing ReviewFlow database
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Shared Redis cache (local defaults to redis://127.0.0.1:6379)
REDIS_URL=

# Prisma uses the Supabase PostgreSQL connection string. Never expose this value to the browser.
DATABASE_URL=

# Optional production integrations.
OPENAI_API_KEY=
COMPETITOR_SEARCH_PROVIDER=openai
COMPETITOR_SEARCH_MODEL=gpt-5.5
COMPETITOR_SEARCH_LIMIT=25
COMPETITOR_SEARCH_TIMEOUT_MS=30000
COMPETITOR_SEARCH_CACHE_TTL_SECONDS=86400
# Optional AI-designed QR backgrounds. Uses the same server-only OPENAI_API_KEY.
QR_DESIGN_IMAGE_MODEL=gpt-image-2.5-flare
QR_DESIGN_TIMEOUT_MS=120000
QR_DESIGN_CACHE_TTL_SECONDS=86400
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=
TOKEN_ENCRYPTION_KEY=

# Native local development (set by `npm run dev:local`; do not use in Vercel)
# REVIEWFLOW_LOCAL_BACKEND=true
# LOCAL_DATABASE_PORT=5433
# JWT_SECRET=replace-with-a-long-random-local-only-value

# Local/demo defaults
USE_MOCK_GOOGLE=true
USE_MOCK_AI=true
