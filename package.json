{
  "name": "reviewflow-web",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "test:competitors": "NODE_OPTIONS=--conditions=react-server tsx --test lib/competitor-discovery.test.ts",
    "test:qr-design": "tsx --test lib/qr-design.test.ts",
    "test:qr-studio": "tsx --test lib/qr-studio.test.ts",
