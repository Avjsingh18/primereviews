    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "7.89.0",
    "react-is": "19.2.4",
    "recharts": "3.10.1",
    "server-only": "0.0.1",
    "sharp": "0.35.5",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "22.9.0",
    "@types/qrcode": "1.5.5",
